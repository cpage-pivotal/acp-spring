<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.tanzu.acp</groupId>
        <artifactId>spring-acp</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>spring-acp-smoke-app</artifactId>
    <name>Spring ACP Smoke App</name>
    <description>Minimal Boot application proving the stack end to end against a real agent</description>

    <dependencies>
        <dependency>
            <groupId>org.tanzu.acp</groupId>
            <artifactId>spring-acp-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!--
          The starter brings Goose. These two make the point of the milestone testable: three agents
          on one classpath, and nothing but spring.acp.runtime chooses between them.
        -->
        <dependency>
            <groupId>org.tanzu.acp</groupId>
            <artifactId>spring-acp-runtime-codex</artifactId>
        </dependency>
        <dependency>
            <groupId>org.tanzu.acp</groupId>
            <artifactId>spring-acp-runtime-opencode</artifactId>
        </dependency>

        <!--
          M4. The registry runtime makes spring.acp.runtime accept an agent none of the three
          adapters claims; the Spring AI adapter publishes the same agent as a ChatModel; actuator
          brings the ObservationRegistry that turns every turn into a timer and a span.
        -->
        <dependency>
            <groupId>org.tanzu.acp</groupId>
            <artifactId>spring-acp-runtime-registry</artifactId>
        </dependency>
        <dependency>
            <groupId>org.tanzu.acp</groupId>
            <artifactId>spring-acp-spring-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
