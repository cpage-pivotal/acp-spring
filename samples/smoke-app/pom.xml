<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springaicommunity.acp</groupId>
        <artifactId>acp-spring</artifactId>
        <version>0.2.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>acp-spring-smoke-app</artifactId>
    <name>ACP Spring Smoke App</name>
    <description>Minimal Boot application proving the stack end to end against a real agent</description>

    <properties>
        <!-- A sample, not a library: built and tested with the rest, never published. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!--
          Three agents on one classpath, and nothing but spring.acp.runtime chooses between them —
          which is also why application.yaml has to name one. The registry starter makes
          spring.acp.runtime accept an agent none of the three adapters claims.
        -->
        <dependency>
            <groupId>org.springaicommunity.acp</groupId>
            <artifactId>acp-spring-boot-starter-goose</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springaicommunity.acp</groupId>
            <artifactId>acp-spring-boot-starter-codex</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springaicommunity.acp</groupId>
            <artifactId>acp-spring-boot-starter-opencode</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springaicommunity.acp</groupId>
            <artifactId>acp-spring-boot-starter-registry</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!--
          The Spring AI adapter publishes the same agent as a ChatModel; actuator brings the
          ObservationRegistry that turns every turn into a timer and a span.
        -->
        <dependency>
            <groupId>org.springaicommunity.acp</groupId>
            <artifactId>acp-spring-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
