<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springaicommunity</groupId>
        <artifactId>spring-ai-acp</artifactId>
        <version>0.4.0</version>
    </parent>

    <artifactId>spring-ai-acp-core</artifactId>
    <name>Spring AI ACP Core</name>
    <description>Runtime-neutral AgentClient, session registry, process supervision and configuration model</description>

    <dependencies>
        <dependency>
            <groupId>com.agentclientprotocol</groupId>
            <artifactId>acp-core</artifactId>
        </dependency>
        <!--
          acp-core carries no JSON implementation since 0.18.0. Jackson 3, as Spring Boot 4 and
          Spring AI 2 use, so an application does not end up with Jackson 2 beside it.
        -->
        <dependency>
            <groupId>com.agentclientprotocol</groupId>
            <artifactId>acp-json-jackson3</artifactId>
        </dependency>
        <!--
          Declared rather than inherited through acp-json-jackson3: EndpointModelCatalog reads an
          endpoint's /models listing, a document the protocol has nothing to do with.
        -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!--
          Optional, like the Spring Boot dependencies: AgentObservations names no Micrometer type,
          and MicrometerAgentObservations is the only class that does. An application without
          Micrometer never loads it and never needs it on the classpath.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-observation</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The SDK's own agent server, which serves a WebSocket upgrade: the far end of
             WebSocketAgentTransportTests. -->
        <dependency>
            <groupId>com.agentclientprotocol</groupId>
            <artifactId>acp-streamable-http-jetty</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>com.agentclientprotocol</groupId>
                    <artifactId>acp-json-jackson2</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
