<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.tanzu.acp</groupId>
    <artifactId>spring-acp</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Spring ACP</name>
    <description>Spring abstraction over Agent Client Protocol coding agents</description>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-boot.version>4.1.0</spring-boot.version>
        <acp.version>0.17.0</acp.version>
        <mockito.version>5.23.0</mockito.version>
    </properties>

    <modules>
        <module>spring-acp-core</module>
        <module>spring-acp-runtime-goose</module>
        <module>spring-acp-runtime-codex</module>
        <module>spring-acp-runtime-opencode</module>
        <module>spring-acp-spring-boot-autoconfigure</module>
        <module>spring-acp-spring-boot-starter</module>
        <module>spring-acp-test</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Official ACP Java SDK. Pre-1.0: no strict semver, pin exactly. -->
            <dependency>
                <groupId>com.agentclientprotocol</groupId>
                <artifactId>acp-core</artifactId>
                <version>${acp.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agentclientprotocol</groupId>
                <artifactId>acp-test</artifactId>
                <version>${acp.version}</version>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>org.tanzu.acp</groupId>
                <artifactId>spring-acp-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.tanzu.acp</groupId>
                <artifactId>spring-acp-spring-boot-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.tanzu.acp</groupId>
                <artifactId>spring-acp-runtime-goose</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.tanzu.acp</groupId>
                <artifactId>spring-acp-runtime-codex</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.tanzu.acp</groupId>
                <artifactId>spring-acp-runtime-opencode</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.tanzu.acp</groupId>
                <artifactId>spring-acp-test</artifactId>
                <version>${project.version}</version>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.6</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
