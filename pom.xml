<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.springaicommunity.acp</groupId>
    <artifactId>acp-spring</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>ACP Spring</name>
    <description>Spring abstraction over Agent Client Protocol coding agents</description>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-boot.version>4.1.0</spring-boot.version>
        <acp.version>0.17.0</acp.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <!-- Pre-1.0 and community-maintained: pinned exactly, like acp-core. -->
        <mcp-security.version>0.1.14</mcp-security.version>
        <mockito.version>5.23.0</mockito.version>
    </properties>

    <modules>
        <module>acp-spring-core</module>
        <module>acp-spring-runtime-goose</module>
        <module>acp-spring-runtime-codex</module>
        <module>acp-spring-runtime-opencode</module>
        <module>acp-spring-runtime-registry</module>
        <module>acp-spring-boot-autoconfigure</module>
        <module>acp-spring-boot-starter</module>
        <module>acp-spring-boot-starter-goose</module>
        <module>acp-spring-boot-starter-codex</module>
        <module>acp-spring-boot-starter-opencode</module>
        <module>acp-spring-boot-starter-registry</module>
        <module>acp-spring-ai</module>
        <module>acp-spring-mcp-oauth</module>
        <module>acp-spring-test</module>
        <module>samples/smoke-app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Official ACP Java SDK. Pre-1.0: no strict semver, pin exactly. -->
            <dependency>
                <groupId>com.agentclientprotocol</groupId>
                <artifactId>acp-core</artifactId>
                <version>${acp.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agentclientprotocol</groupId>
                <artifactId>acp-test</artifactId>
                <version>${acp.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springaicommunity.acp</groupId>
                <artifactId>acp-spring-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springaicommunity.acp</groupId>
                <artifactId>acp-spring-boot-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springaicommunity.acp</groupId>
                <artifactId>acp-spring-runtime-goose</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springaicommunity.acp</groupId>
                <artifactId>acp-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springaicommunity.acp</groupId>
                <artifactId>acp-spring-boot-starter-goose</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springaicommunity.acp</groupId>
                <artifactId>acp-spring-boot-starter-codex</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springaicommunity.acp</groupId>
                <artifactId>acp-spring-boot-starter-opencode</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springaicommunity.acp</groupId>
                <artifactId>acp-spring-boot-starter-registry</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springaicommunity.acp</groupId>
                <artifactId>acp-spring-runtime-codex</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springaicommunity.acp</groupId>
                <artifactId>acp-spring-runtime-opencode</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springaicommunity.acp</groupId>
                <artifactId>acp-spring-runtime-registry</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springaicommunity.acp</groupId>
                <artifactId>acp-spring-ai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springaicommunity.acp</groupId>
                <artifactId>acp-spring-mcp-oauth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springaicommunity.acp</groupId>
                <artifactId>acp-spring-test</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Lets `mvn deploy -Partifact-registry` authenticate with gcloud's credentials. -->
        <extensions>
            <extension>
                <groupId>com.google.cloud.artifactregistry</groupId>
                <artifactId>artifactregistry-maven-wagon</artifactId>
                <version>2.2.5</version>
            </extension>
        </extensions>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.6</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.1.4</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Publishes to the public Artifact Registry repository: mvn deploy -Partifact-registry -->
        <profile>
            <id>artifact-registry</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
            <distributionManagement>
                <repository>
                    <id>artifact-registry</id>
                    <name>GCP Artifact Registry</name>
                    <url>artifactregistry://us-central1-maven.pkg.dev/cf-mcp/maven-public</url>
                </repository>
                <snapshotRepository>
                    <id>artifact-registry</id>
                    <name>GCP Artifact Registry Snapshots</name>
                    <url>artifactregistry://us-central1-maven.pkg.dev/cf-mcp/maven-public</url>
                </snapshotRepository>
            </distributionManagement>
        </profile>
    </profiles>
</project>
